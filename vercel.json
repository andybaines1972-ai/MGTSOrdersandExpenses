{
  "functions": {
    "api/send-email.js":    { "memory": 128, "maxDuration": 10 },
    "api/invite-users.js":  { "memory": 128, "maxDuration": 10 },
    "api/next-ref.js":      { "memory": 128, "maxDuration": 10 },
    "api/admin-delete.js":  { "memory": 128, "maxDuration": 10 },
    "api/update-user.js":   { "memory": 128, "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.supabase.co https://api.resend.com https://api.postcodes.io https://router.project-osrm.org; img-src 'self' data: blob: https://*.supabase.co; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
